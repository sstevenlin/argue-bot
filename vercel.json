{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/static/(.*)", "dest": "public/static/$1" },
    { "src": "/api/(.*)", "dest": "api/index.py" },
    { "src": "/", "dest": "public/index.html" }
  ]
}
